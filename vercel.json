{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/healthz",
      "destination": "/api/healthz"
    },
    {
      "source": "/readyz",
      "destination": "/api/readyz"
    },
    {
      "source": "/metrics",
      "destination": "/api/metrics"
    }
  ],
  "crons": [
    {
      "path": "/api/internal/cron/product-sync",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/internal/cron/refresh-dispatch",
      "schedule": "*/2 * * * *"
    },
    {
      "path": "/api/internal/cron/status-poll",
      "schedule": "*/2 * * * *"
    },
    {
      "path": "/api/internal/cron/reconciliation",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/internal/cron/dead-letter",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/internal/cron/retention",
      "schedule": "0 3 * * *"
    }
  ]
}
